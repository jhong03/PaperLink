{
  "name": "paperlink",
  "version": "0.1.27",
  "description": "A local desktop workspace for linked documents and spreadsheets",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/bundle-protection.mjs",
    "start": "npm run build && electron .",
    "test": "node --test tests/model.test.mjs",
    "test:desktop": "npm run build && node tests/desktop-smoke.mjs",
    "samples": "node scripts/create-samples.mjs",
    "package": "npm run build && node scripts/license-notices.mjs && node --require ./scripts/windows-builder-env.cjs node_modules/electron-builder/cli.js --win nsis portable --x64",
    "package:dir": "npm run build && electron-builder --win --dir --x64"
  },
  "dependencies": {
    "@formulajs/formulajs": "^4.0.0",
    "@libpdf/core": "0.5.3",
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/extension-text-align": "^3.0.0",
    "@tiptap/extension-text-style": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "docx": "^9.0.0",
    "dompurify": "^3.0.0",
    "html-to-image": "^1.11.0",
    "jszip": "^3.10.0",
    "nodemailer": "10.1.1",
    "officecrypto-tool": "0.0.19",
    "rtf.js": "^3.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xlsx-calc": "^0.9.0"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "^26.0.0",
    "esbuild": "0.28.2",
    "playwright": "^1.0.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.paperlink.app",
    "productName": "PaperLink",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": ".cache/protection-worker.cjs",
        "to": "protection-worker.cjs"
      },
      {
        "from": "samples",
        "to": "samples"
      },
      {
        "from": "docs",
        "to": "docs"
      },
      {
        "from": "node_modules/nodemailer",
        "to": "mail/nodemailer"
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false,
      "artifactName": "PaperLink-Setup.exe"
    },
    "nsis": {
      "guid": "5c8d14f5-563f-5a3e-af61-03d776c2cbc7",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "PaperLink-portable.exe"
    }
  }
}
